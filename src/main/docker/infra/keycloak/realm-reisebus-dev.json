{
  "realm": "reisebus-dev",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "clients": [
    {
      "clientId": "reisebus-web",
      "name": "Reisebus Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*",
        "http://acme.localhost:8080/*",
        "http://ettenhuber.localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8080",
        "http://acme.localhost:8080",
        "http://ettenhuber.localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "reisebus-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "reisebus-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "reisebus-api",
      "name": "Reisebus API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "access.token.lifespan": "9000"
      }
    }
  ],
  "users": [
    {
      "username": "admin@test.local",
      "enabled": true,
      "email": "admin@test.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-reisebus-dev"
      ]
    },
    {
      "username": "staff@test.local",
      "enabled": true,
      "email": "staff@test.local",
      "emailVerified": true,
      "firstName": "Staff",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "staff123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-reisebus-dev"
      ]
    }
  ]
}